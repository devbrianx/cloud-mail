{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloud-mail-vitest",
  "main": "src/index.js",
  "compatibility_date": "2025-06-04",
  "d1_databases": [
    { "binding": "db", "database_name": "cloud-mail-vitest", "database_id": "00000000-0000-0000-0000-000000000001" }
  ],
  "kv_namespaces": [
    { "binding": "kv", "id": "00000000000000000000000000000001" }
  ],
  "vars": {
    "domain": ["example.com", "alt.example.com"],
    "admin": "admin@example.com",
    "jwt_secret": "test-jwt-secret",
    "outlook_client_id": "test-outlook-client-id",
    "outlook_client_secret": "test-outlook-client-secret"
  }
}
